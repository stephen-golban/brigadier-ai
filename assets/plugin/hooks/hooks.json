{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo brigadier: carry forward the run id, the integration ref and the failing checks - not the transcript."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "brigadier hook user-prompt-submit 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
