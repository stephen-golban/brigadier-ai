## claude mcp
usage	Usage: claude mcp [options] [command]
body-digest	4e505cf11a7317b0
opt	--help	flags=-h, --help	arg=	:: Display help for command
cmd	add	flags=add	arg=[options] <name> <commandOrUrl> [args...]	:: Add an MCP server to Claude Code.
cmd	add-from-claude-desktop	flags=add-from-claude-desktop	arg=[options]	:: Import MCP servers from Claude Desktop (Mac and WSL only)
cmd	add-json	flags=add-json	arg=[options] <name> <json>	:: Add an MCP server (stdio, SSE, HTTP, or WebSocket) with a JSON string
cmd	get	flags=get	arg=<name>	:: Get details about an MCP server. Unapproved .mcp.json servers are shown as ⏸ Pending approval and not connected to; approved servers are health-checked unless disabled for this project.
cmd	help	flags=help	arg=[command]	:: display help for command
cmd	list	flags=list	arg=	:: List configured MCP servers. Unapproved .mcp.json servers are shown as ⏸ Pending approval and not connected to; approved servers are health-checked unless disabled for this project.
cmd	login	flags=login	arg=[options] <name>	:: Authenticate with an MCP server (HTTP, SSE, or claude.ai connector)
cmd	logout	flags=logout	arg=<name>	:: Clear stored OAuth credentials for an MCP server
cmd	remove	flags=remove	arg=[options] <name>	:: Remove an MCP server
cmd	reset-project-choices	flags=reset-project-choices	arg=	:: Reset all approved and rejected project-scoped (.mcp.json) servers within this project
cmd	serve	flags=serve	arg=[options]	:: Start the Claude Code MCP server

## claude plugin
usage	Usage: claude plugin|plugins [options] [command]
body-digest	e423162764d6df24
opt	--help	flags=-h, --help	arg=	:: Display help for command
cmd	details	flags=details	arg=[options] <name>	:: Show a plugin's component inventory and projected token cost
cmd	disable	flags=disable	arg=[options] [plugin]	:: Disable an enabled plugin
cmd	enable	flags=enable	arg=[options] <plugin>	:: Enable a disabled plugin
cmd	eval	flags=eval	arg=[options] [target]	:: Run eval cases (<eval dir>/**/case.yaml or prompt.md + graders/*.md; the eval dir is evals/ unless --eval-dir or the manifest says otherwise) against a plugin and report scored results. Target is a path, a plugin name, or a `plugin@marketplace` id — installed and skills-dir plugins both resolve (and add a no-plugin baseline arm)
cmd	help	flags=help	arg=[command]	:: display help for command
cmd	init	flags=init|new	arg=[options] <name>	:: Scaffold a new plugin at ~/.claude/skills/<name>/ (auto-loads next session as <name>@skills-dir)
cmd	install	flags=install|i	arg=[options] <plugin>	:: Install a plugin from available marketplaces (use plugin@marketplace for specific marketplace)
cmd	list	flags=list	arg=[options]	:: List installed plugins
cmd	marketplace	flags=marketplace	arg=	:: Manage Claude Code marketplaces
cmd	prune	flags=prune|autoremove	arg=[options]	:: Remove auto-installed dependencies that are no longer needed
cmd	tag	flags=tag	arg=[options] [path]	:: Create a {name}--v{version} git tag for a plugin release, validating that plugin.json and any enclosing marketplace entry agree
cmd	uninstall	flags=uninstall|remove	arg=[options] <plugin>	:: Uninstall an installed plugin
cmd	update	flags=update	arg=[options] <plugin>	:: Update a plugin to the latest version (restart required to apply)
cmd	validate	flags=validate	arg=[options] <path>	:: Validate a plugin or marketplace manifest, or the skills, agents, and commands in a directory

