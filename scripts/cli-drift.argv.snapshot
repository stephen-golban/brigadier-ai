# claude CLI argv surface — snapshot
# generated by scripts/cli-drift.mjs; regenerate with `node scripts/cli-drift.mjs --update`
# built from `claude --version` and `claude [<sub>] --help` only. No session, no prompt, no spend.

cli-version	2.1.261 (Claude Code)

## claude
usage	Usage: claude [options] [command] [prompt]
body-digest	ee98bdaa88caf0e8
arg	prompt	flags=prompt	arg=	:: Your prompt
opt	--add-dir	flags=--add-dir	arg=<directories...>	:: Additional directories to allow tool access to
opt	--agent	flags=--agent	arg=<agent>	:: Agent for the current session. Overrides the 'agent' setting.
opt	--agents	flags=--agents	arg=<json>	:: JSON object defining custom agents (e.g. '{"reviewer": {"description": "Reviews code", "prompt": "You are a code reviewer"}}')
opt	--allow-dangerously-skip-permissions	flags=--allow-dangerously-skip-permissions	arg=	:: Enable bypassing all permission checks as an option, without it being enabled by default. Recommended only for sandboxes with no internet access.
opt	--allowed-tools	flags=--allowedTools, --allowed-tools	arg=<tools...>	:: Comma or space-separated list of tool names to allow (e.g. "Bash(git *) Edit")
opt	--append-system-prompt	flags=--append-system-prompt	arg=<prompt>	:: Append a system prompt to the default system prompt
opt	--autocompact	flags=--autocompact	arg=<auto|tokens>	:: Auto-compact window size (auto, or 100k–1M tokens)
opt	--ax-screen-reader	flags=--ax-screen-reader	arg=	:: Render screen-reader friendly output (flat text, no decorative borders or animations).
opt	--background	flags=--bg, --background	arg=	:: Start the session in the background and return immediately. Prints the id that `claude attach`, `logs`, `stop` and `rm` take; `claude agents` lists them. With --resume <session-id>, continues that session in the background under the same ID, or starts a copy and says so when the session is already running
opt	--bare	flags=--bare	arg=	:: Minimal mode: skip hooks, LSP, plugin sync, attribution, auto-memory, background prefetches, keychain reads, and CLAUDE.md auto-discovery. Sets CLAUDE_CODE_SIMPLE=1. Anthropic auth is strictly ANTHROPIC_API_KEY or apiKeyHelper via --settings (OAuth and keychain are never read). 3P providers (Bedrock/Vertex/Foundry) use their own credentials. Skills still resolve via /skill-name. Explicitly provide context via: --system-prompt[-file], --append-system-prompt[-file], --add-dir (CLAUDE.md dirs), --mcp-config, --settings, --agents, --plugin-dir.
opt	--betas	flags=--betas	arg=<betas...>	:: Beta headers to include in API requests (API key users only)
opt	--brief	flags=--brief	arg=	:: Enable SendUserMessage tool for agent-to-user communication
opt	--chrome	flags=--chrome	arg=	:: Enable Claude in Chrome integration
opt	--cloud	flags=--cloud	arg=[description|session_id|url]	:: Create a cloud session with the given description, or attach to an existing one by session ID or claude.ai/code URL
opt	--continue	flags=-c, --continue	arg=	:: Continue the most recent conversation in the current directory
opt	--dangerously-skip-permissions	flags=--dangerously-skip-permissions	arg=	:: Bypass all permission checks. Recommended only for sandboxes with no internet access.
opt	--debug	flags=-d, --debug	arg=[filter]	:: Enable debug mode with optional category filtering (e.g., "api,hooks" or "!1p,!file")
opt	--debug-file	flags=--debug-file	arg=<path>	:: Write debug logs to a specific file path (implicitly enables debug mode)
opt	--disable-slash-commands	flags=--disable-slash-commands	arg=	:: Disable all skills
opt	--disallowed-tools	flags=--disallowedTools, --disallowed-tools	arg=<tools...>	:: Comma or space-separated list of tool names to deny (e.g. "Bash(git *) Edit")
opt	--effort	flags=--effort	arg=<level>	:: Effort level for the current session (low, medium, high, xhigh, max)
opt	--environment	flags=--environment	arg=<environment_id>	:: Create a new cloud session that runs on the given self-hosted environment (ccpool_...).
opt	--exclude-dynamic-system-prompt-sections	flags=--exclude-dynamic-system-prompt-sections	arg=	:: Move per-machine sections (cwd, env info, memory paths, git status) from the system prompt into the first user message. Improves cross-user prompt-cache reuse. Only applies with the default system prompt (ignored with --system-prompt). (default: false)
opt	--fallback-model	flags=--fallback-model	arg=<model>	:: Enable automatic fallback to specified model(s) when the default model is overloaded or not available. Accepts a comma-separated list to try each in order. Re-tries the primary at the start of each user turn. (only works with --print)
opt	--file	flags=--file	arg=<specs...>	:: File resources to download at startup. Format: file_id:relative_path (e.g., --file file_abc:doc.txt file_def:img.png)
opt	--fork-session	flags=--fork-session	arg=	:: When resuming, create a new session ID instead of reusing the original (use with --resume or --continue)
opt	--forward-subagent-text	flags=--forward-subagent-text	arg=	:: Forward subagent text and thinking blocks as assistant/user messages with parent_tool_use_id set (only works with --print and --output-format=stream-json)
opt	--from-pr	flags=--from-pr	arg=[value]	:: Resume a session linked to a PR by PR number/URL, or open interactive picker with optional search term
opt	--help	flags=-h, --help	arg=	:: Display help for command
opt	--ide	flags=--ide	arg=	:: Automatically connect to IDE on startup if exactly one valid IDE is available
opt	--include-hook-events	flags=--include-hook-events	arg=	:: Include all hook lifecycle events in the output stream (only works with --output-format=stream-json)
opt	--include-partial-messages	flags=--include-partial-messages	arg=	:: Include partial message chunks as they arrive (only works with --print and --output-format=stream-json)
opt	--input-format	flags=--input-format	arg=<format>	:: Input format (only works with --print): "text" (default), or "stream-json" (realtime streaming input) (choices: "text", "stream-json")
opt	--json-schema	flags=--json-schema	arg=<schema>	:: JSON Schema for structured output validation. Example: {"type":"object","properties":{"name":{"type":"string"}},"required":["name"]}
opt	--max-budget-usd	flags=--max-budget-usd	arg=<amount>	:: Maximum dollar amount to spend on API calls (only works with --print)
opt	--mcp-config	flags=--mcp-config	arg=<configs...>	:: Load MCP servers from JSON files or strings (space-separated)
opt	--model	flags=--model	arg=<model>	:: Model for the current session. Provide an alias for the latest model (e.g. 'fable', 'opus', or 'sonnet') or a model's full name (e.g. 'claude-fable-5').
opt	--name	flags=-n, --name	arg=<name>	:: Set a display name for this session (shown in the prompt box, /resume picker, and terminal title)
opt	--no-chrome	flags=--no-chrome	arg=	:: Disable Claude in Chrome integration
opt	--no-session-persistence	flags=--no-session-persistence	arg=	:: Disable session persistence - sessions will not be saved to disk and cannot be resumed (only works with --print)
opt	--output-format	flags=--output-format	arg=<format>	:: Output format (only works with --print): "text" (default), "json" (single result), or "stream-json" (realtime streaming) (choices: "text", "json", "stream-json")
opt	--permission-mode	flags=--permission-mode	arg=<mode>	:: Permission mode to use for the session (choices: "acceptEdits", "auto", "bypassPermissions", "manual", "dontAsk", "plan")
opt	--permission-prompts	flags=--permission-prompts	arg=<target>	:: Who answers permission prompts with --print: "host" (the SDK host or --permission-prompt-tool) or "none" (nobody: anything that would prompt is denied automatically; the permission mode still decides everything else) (choices: "host", "none", default: "host")
opt	--plugin-dir	flags=--plugin-dir	arg=<path>	:: Load a plugin from a directory or .zip for this session only (repeatable: --plugin-dir A --plugin-dir B.zip) (default: [])
opt	--plugin-url	flags=--plugin-url	arg=<url>	:: Fetch a plugin .zip from a URL for this session only (repeatable: --plugin-url A --plugin-url B) (default: [])
opt	--print	flags=-p, --print	arg=	:: Print response and exit (useful for pipes). Note: The workspace trust dialog is skipped when Claude is run in non-interactive mode (via -p, or when stdout is not a TTY, e.g. piped or redirected output). Only use this in directories you trust. Settings files that fail validation are silently ignored in this mode (no error dialog is shown).
opt	--prompt-suggestions	flags=--prompt-suggestions	arg=[value]	:: Enable prompt suggestions. In print/SDK mode, emits a prompt_suggestion message after each turn with a predicted next user prompt (choices: "true", "false", "1", "0", "yes", "no", "on", "off", preset: "true")
opt	--remote-control	flags=--remote-control	arg=[name]	:: Start an interactive session with Remote Control enabled (optionally named)
opt	--remote-control-session-name-prefix	flags=--remote-control-session-name-prefix	arg=<prefix>	:: Prefix for auto-generated Remote Control session names (default: hostname)
opt	--replay-user-messages	flags=--replay-user-messages	arg=	:: Re-emit user messages from stdin back on stdout for acknowledgment (only works with --input-format=stream-json and --output-format=stream-json)
opt	--restricted	flags=--restricted	arg=	:: Restricted mode: removes the built-in tools that run commands or code (Bash, PowerShell, REPL and the other code-running tools) and WebFetch unless --tools names them, and ignores user, project and local settings files (managed settings and --settings still apply; add --strict-mcp-config to skip MCP servers too). Also confines the file tools to the working directories (--add-dir included), refuses bypassPermissions, and lets only a person or the configured permission handler approve writes to settings, git and tool-configuration files.
opt	--resume	flags=-r, --resume	arg=[value]	:: Resume a conversation by session ID, or open interactive picker with optional search term
opt	--safe-mode	flags=--safe-mode	arg=	:: Start with all customizations (CLAUDE.md, skills, plugins, hooks, MCP servers, custom commands and agents, output styles, workflows, custom themes, keybindings, and more) disabled — useful for troubleshooting a broken configuration. Admin-managed (policy) settings still apply. Auth, model selection, built-in tools, and permissions work normally. Sets CLAUDE_CODE_SAFE_MODE=1.
opt	--session-id	flags=--session-id	arg=<uuid>	:: Use a specific session ID for the conversation (must be a valid UUID)
opt	--setting-sources	flags=--setting-sources	arg=<sources>	:: Comma-separated list of setting sources to load (user, project, local).
opt	--settings	flags=--settings	arg=<file-or-json>	:: Path to a settings JSON file or a JSON string to load additional settings from
opt	--strict-mcp-config	flags=--strict-mcp-config	arg=	:: Only use MCP servers from --mcp-config, ignoring all other MCP configurations
opt	--system-prompt	flags=--system-prompt	arg=<prompt>	:: System prompt to use for the session
opt	--system-prompt-snapshot	flags=--system-prompt-snapshot	arg=<on|off>	:: Record the system prompt once per conversation and reuse it verbatim on every request and resume (recommended: on). By default it is on for the built-in prompt, and passing --system-prompt or --append-system-prompt turns it off so the given text applies fresh each launch. on: an existing record in the conversation is sent as-is (a later launch's different --system-prompt/--append-system-prompt is ignored until compaction); otherwise the prompt is rendered with the append included, sent, and recorded. off: never record. No effect where system-prompt recording is not yet enabled. (choices: "on", "off")
opt	--teleport	flags=--teleport	arg=[session]	:: Resume a teleport session, optionally specify session ID
opt	--tmux	flags=--tmux	arg=	:: Create a tmux session for the worktree (requires --worktree). Uses iTerm2 native panes when available; use --tmux=classic for traditional tmux.
opt	--tools	flags=--tools	arg=<tools...>	:: Specify the list of available tools from the built-in set. Use "" to disable all tools, "default" to use all tools, or specify tool names (e.g. "Bash,Edit,Read").
opt	--verbose	flags=--verbose	arg=	:: Override verbose mode setting from config
opt	--version	flags=-v, --version	arg=	:: Output the version number
opt	--worktree	flags=-w, --worktree	arg=[name]	:: Create a new git worktree for this session (optionally specify a name)
cmd	agents	flags=agents	arg=[options]	:: Manage background agents
cmd	attach	flags=attach	arg=<id>	:: Open a background session in this terminal. <id> is the short id that `claude --bg` prints and `claude agents` lists
cmd	auth	flags=auth	arg=	:: Manage authentication
cmd	auto-mode	flags=auto-mode	arg=	:: Inspect or reset auto mode classifier configuration
cmd	doctor	flags=doctor	arg=	:: Check the health of your Claude Code installation. Reads settings files in the current directory without a trust prompt. For a full checkup that can also fix issues, run /doctor in a session.
cmd	gateway	flags=gateway	arg=[options]	:: Run the enterprise auth/telemetry gateway
cmd	import	flags=import	arg=[options] [source]	:: Import config from another AI coding agent into Claude Code
cmd	install	flags=install	arg=[options] [target]	:: Install Claude Code native build. Use [target] to specify version (stable, latest, or specific version)
cmd	logs	flags=logs	arg=<id>	:: Print a background session's recent terminal output
cmd	mcp	flags=mcp	arg=	:: Configure and manage MCP servers
cmd	plugin	flags=plugin|plugins	arg=	:: Manage Claude Code plugins
cmd	project	flags=project	arg=	:: Manage Claude Code project state
cmd	respawn	flags=respawn	arg=[options] [id]	:: Restart a background session, or all of them with --all, so it runs the current Claude Code version
cmd	rm	flags=rm	arg=<id>	:: Delete a background session, and its worktree when that is safe. Works on sessions that have already exited
cmd	setup-token	flags=setup-token	arg=	:: Set up a long-lived authentication token (requires Claude subscription)
cmd	stop	flags=stop|kill	arg=<id>	:: Stop a background session. Its conversation is kept: `claude attach <id>` opens it again, `claude --resume` works once it is stopped
cmd	ultrareview	flags=ultrareview	arg=[options] [target]	:: Run a cloud-hosted multi-agent code review of the current branch (or a PR number / base branch) and print the findings
cmd	update	flags=update|upgrade	arg=	:: Check for updates and install if available

## claude agents
usage	Usage: claude agents [options]
body-digest	ad766e53eface2a6
opt	--add-dir	flags=--add-dir	arg=<directory>	:: Additional directory to allow tool access to in dispatched sessions (repeatable)
opt	--agent	flags=--agent	arg=<agent>	:: Default agent for sessions dispatched from agent view. Overrides the 'agent' setting.
opt	--all	flags=--all	arg=	:: With --json: also include completed background sessions
opt	--allow-dangerously-skip-permissions	flags=--allow-dangerously-skip-permissions	arg=	:: Make bypass-permissions mode available to dispatched sessions without defaulting to it
opt	--cwd	flags=--cwd	arg=<path>	:: Show only background sessions started under <path>
opt	--dangerously-skip-permissions	flags=--dangerously-skip-permissions	arg=	:: Alias for --permission-mode bypassPermissions
opt	--effort	flags=--effort	arg=<level>	:: Default effort level for sessions dispatched from agent view
opt	--help	flags=-h, --help	arg=	:: Display help for command
opt	--json	flags=--json	arg=	:: Print active sessions (interactive and background) as a JSON array and exit (for scripting; does not require a TTY)
opt	--mcp-config	flags=--mcp-config	arg=<config>	:: MCP server configuration to apply to dispatched sessions (repeatable)
opt	--model	flags=--model	arg=<model>	:: Default model for sessions dispatched from agent view
opt	--permission-mode	flags=--permission-mode	arg=<mode>	:: Default permission mode for sessions dispatched from agent view
opt	--plugin-dir	flags=--plugin-dir	arg=<path>	:: Load plugins from specified directory for the agent view and dispatched sessions (repeatable)
opt	--restricted	flags=--restricted	arg=	:: Start dispatched sessions in restricted mode
opt	--setting-sources	flags=--setting-sources	arg=<sources>	:: Comma-separated list of setting sources to load (user, project, local).
opt	--settings	flags=--settings	arg=<file-or-json>	:: Settings file or JSON string to apply to the agent view and dispatched sessions
opt	--strict-mcp-config	flags=--strict-mcp-config	arg=	:: Only use MCP servers from --mcp-config in dispatched sessions

